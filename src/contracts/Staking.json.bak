9:169;;;;:::o;9244:305::-;9284:3;9303:20;9321:1;9303:20;:::i;:::-;9298:25;;9337:20;9355:1;9337:20;:::i;:::-;9332:25;;9491:1;9423:66;9419:74;9416:1;9413:81;9410:107;;;9497:18;;:::i;:::-;9410:107;9541:1;9538;9534:9;9527:16;;9244:305;;;;:::o;9555:185::-;9595:1;9612:20;9630:1;9612:20;:::i;:::-;9607:25;;9646:20;9664:1;9646:20;:::i;:::-;9641:25;;9685:1;9675:35;;9690:18;;:::i;:::-;9675:35;9732:1;9729;9725:9;9720:14;;9555:185;;;;:::o;9746:348::-;9786:7;9809:20;9827:1;9809:20;:::i;:::-;9804:25;;9843:20;9861:1;9843:20;:::i;:::-;9838:25;;10031:1;9963:66;9959:74;9956:1;9953:81;9948:1;9941:9;9934:17;9930:105;9927:131;;;10038:18;;:::i;:::-;9927:131;10086:1;10083;10079:9;10068:20;;9746:348;;;;:::o;10100:191::-;10140:4;10160:20;10178:1;10160:20;:::i;:::-;10155:25;;10194:20;10212:1;10194:20;:::i;:::-;10189:25;;10233:1;10230;10227:8;10224:34;;;10238:18;;:::i;:::-;10224:34;10283:1;10280;10276:9;10268:17;;10100:191;;;;:::o;10297:96::-;10334:7;10363:24;10381:5;10363:24;:::i;:::-;10352:35;;10297:96;;;:::o;10399:90::-;10433:7;10476:5;10469:13;10462:21;10451:32;;10399:90;;;:::o;10495:126::-;10532:7;10572:42;10565:5;10561:54;10550:65;;10495:126;;;:::o;10627:77::-;10664:7;10693:5;10682:16;;10627:77;;;:::o;10710:134::-;10768:9;10801:37;10832:5;10801:37;:::i;:::-;10788:50;;10710:134;;;:::o;10850:141::-;10915:9;10948:37;10979:5;10948:37;:::i;:::-;10935:50;;10850:141;;;:::o;10997:126::-;11047:9;11080:37;11111:5;11080:37;:::i;:::-;11067:50;;10997:126;;;:::o;11129:113::-;11179:9;11212:24;11230:5;11212:24;:::i;:::-;11199:37;;11129:113;;;:::o;11248:180::-;11296:77;11293:1;11286:88;11393:4;11390:1;11383:15;11417:4;11414:1;11407:15;11434:180;11482:77;11479:1;11472:88;11579:4;11576:1;11569:15;11603:4;11600:1;11593:15;11620:180;11668:77;11665:1;11658:88;11765:4;11762:1;11755:15;11789:4;11786:1;11779:15;11806:180;11854:77;11851:1;11844:88;11951:4;11948:1;11941:15;11975:4;11972:1;11965:15;12115:117;12224:1;12221;12214:12;12238:176;12378:28;12374:1;12366:6;12362:14;12355:52;12238:176;:::o;12420:173::-;12560:25;12556:1;12548:6;12544:14;12537:49;12420:173;:::o;12599:160::-;12739:12;12735:1;12727:6;12723:14;12716:36;12599:160;:::o;12765:168::-;12905:20;12901:1;12893:6;12889:14;12882:44;12765:168;:::o;12939:169::-;13079:21;13075:1;13067:6;13063:14;13056:45;12939:169;:::o;13114:180::-;13254:32;13250:1;13242:6;13238:14;13231:56;13114:180;:::o;13300:122::-;13373:24;13391:5;13373:24;:::i;:::-;13366:5;13363:35;13353:63;;13412:1;13409;13402:12;13353:63;13300:122;:::o;13428:116::-;13498:21;13513:5;13498:21;:::i;:::-;13491:5;13488:32;13478:60;;13534:1;13531;13524:12;13478:60;13428:116;:::o;13550:122::-;13623:24;13641:5;13623:24;:::i;:::-;13616:5;13613:35;13603:63;;13662:1;13659;13652:12;13603:63;13550:122;:::o",
  "source": "// SPDX-License-Identifier: MIT\r\npragma solidity ^0.8.7;\r\nimport \"./IBEP20.sol\";\r\n\r\ncontract Staking{\r\n\r\n    event FundsWithdrawn(address owner,uint amount,uint date);\r\n    event Staked(address owner,uint amount,uint date);\r\n    event Unstaked(address owner,uint date);\r\n    \r\n\r\n    struct stakeholder{\r\n        address payable _address;\r\n        uint joinedOn;\r\n        uint lastWithdrawedOn;\r\n    }\r\n\r\n    stakeholder[] internal stakeholders;\r\n    IBEP20 public asset;\r\n    address admin;\r\n    uint totalBalance;\r\n\r\n\r\n    mapping(address=>uint) public stakes;\r\n    mapping(address=>uint) public rewards;\r\n\r\n    constructor (address _admin,address _asset,uint _total){\r\n        asset = IBEP20(_asset);\r\n        admin = _admin;\r\n        totalBalance = _total;\r\n    }\r\n\r\n    function createStake(uint _stake) public payable {\r\n            stakes[msg.sender] += _stake;\r\n            asset.transferFrom( msg.sender, payable(address(this)),_stake);\r\n            emit Staked(msg.sender,_stake,block.timestamp);\r\n    }\r\n\r\n\r\n\r\n    function removeStake(address _stakeholder) public {\r\n        uint s = stakes[_stakeholder];\r\n        if(stakes[_stakeholder] == 0) return;\r\n        stakes[_stakeholder] = 0;\r\n        asset.transferFrom(address(this),payable(_stakeholder),s);\r\n        emit Unstaked(msg.sender,block.timestamp);\r\n    }\r\n\r\n    function createStakeHolder(uint _stake) public{\r\n        require(_stake > 0,\"cannot stake an invalid amount\");\r\n        stakeholder memory s = stakeholder(payable(msg.sender),block.timestamp,block.timestamp);\r\n        stakeholders.push(s);\r\n        createStake(_stake);\r\n    }\r\n\r\n    \r\n    receive() external payable{}\r\n\r\n    function stakeOf (address _stakeholder)public view returns (uint){\r\n        return stakes[_stakeholder];\r\n    }\r\n\r\n    function totalStake() public view returns (uint){\r\n        uint total = 0;\r\n        for(uint i = 0; i < stakeholders.length; i += 1){\r\n            total += stakes[stakeholders[i]._address];\r\n        }\r\n        return total;\r\n    }\r\n \r\n\r\n    function isStakeholder(address _stakeholder) public view returns (bool,uint){\r\n        for(uint i = 0; i < stakeholders.length; i +=1){\r\n            if(stakeholders[i]._address == _stakeholder){\r\n                return (true,i);\r\n            }\r\n        }\r\n        return (false,0);\r\n    }\r\n\r\n    function removeStakeHolder() public {\r\n        (bool _isStakeholder,uint index) = isStakeholder(msg.sender);\r\n          if(_isStakeholder){\r\n            stakeholders[index] = stakeholders[stakeholders.length - 1];\r\n            stakeholders.pop();\r\n            removeStake(msg.sender);\r\n        }\r\n    }\r\n\r\n    function rewardOf(address _stakeholder)view public returns (uint){\r\n        return rewards[_stakeholder];\r\n    }\r\n\r\n    function calculateReward(address _stakeholder) public view returns (uint) {\r\n        uint ONE_YEAR = 31556926;\r\n        (bool _isStakeholder,uint index) = isStakeholder(_stakeholder);\r\n        uint _staked = stakes[_stakeholder];\r\n        require(_isStakeholder , \"not a stake holder\");\r\n        stakeholder memory s = stakeholders[index];\r\n        uint timeDifference = block.timestamp - s.lastWithdrawedOn;\r\n        uint _percentage = (timeDifference * 15)/(ONE_YEAR * 100);\r\n        return _percentage * _staked;\r\n    }\r\n\r\n    function withdrawReward() public {\r\n        (bool _isStakeholder,uint index) = isStakeholder(msg.sender);\r\n        uint r = calculateReward(msg.sender);\r\n        uint _reward = rewards[msg.sender];\r\n        require(_isStakeholder == true, \"you must be a stake holder\");\r\n        require(stakes[stakeholders[index]._address] > 0,\"you dont have any stake\");\r\n        require(r > 0, \"no available reward\");\r\n        if(r > totalBalance){\r\n            rewards[msg.sender] = 0;\r\n            totalBalance -= _reward;\r\n            stakeholders[index].lastWithdrawedOn = block.timestamp;\r\n            asset.transferFrom(address(this),payable(msg.sender),_reward);\r\n            emit FundsWithdrawn(msg.sender,r,block.timestamp);\r\n            return;\r\n        }\r\n        rewards[msg.sender] = 0;\r\n        totalBalance -= r;\r\n        stakeholders[index].lastWithdrawedOn = block.timestamp;\r\n        asset.transferFrom(address(this),payable(msg.sender),r);\r\n        emit FundsWithdrawn(msg.sender,r,block.timestamp);\r\n    }\r\n\r\n    function distributeReward() public {\r\n        require(msg.sender == admin, \"only admin\");\r\n        for(uint i = 0; i < stakeholders.length; i += 1){\r\n            address _stakeholder = stakeholders[i]._address;\r\n            uint reward = calculateReward(_stakeholder);\r\n            rewards[_stakeholder] = reward;\r\n        }\r\n    }\r\n\r\n    function totalReward() public view returns (uint){\r\n        uint _total = 0;\r\n        for(uint i = 0; 1 < stakeholders.length; i += 1){\r\n            _total += rewards[stakeholders[i]._address];\r\n        }\r\n        return _total;\r\n    }\r\n}",
  "sourcePath": "C:\\Users\\Abdul - PC\\Desktop\\dexscrow\\contracts\\staking.sol",
