}

.step .inner{ 
 border:1px solid #5F46D5;
 min-height:200px;
 border-radius:10px;
}

.step .inner .sport{ 
 border:1px solid #5F46D5;
 background:#5F46D5;
 border-radius:10px;
 min-height:100px;
 width:100%;
}

.step .inner .sport h3{ 
  color:#fff;
  font-size:17px;
}

.step .inner .bet-single-area {
  background:#5F46D5;
  border-radius: 10px;
  margin-bottom: 30px;
}

.step .inner .bet-single-area .head-area {
  background: #382591;
  padding: 13px 20px;
  border-top-right-radius: 10px;
  border-top-left-radius: 10px;
}


.match{ 
   margin-top:20px;
}

.match .inner{ 
 min-height:200px;
 border-radius:10px;
 min-height:200px;
 border-radius:10px;
}

.match .inner .sport{ 
 border:1px solid #5F46D5;
 background:#5F46D5;
 border-radius:10px;
 min-height:100px;
 width:100%;
}

.match .inner .sport h3{ 
  color:#fff;
  font-size:17px;
}

.match .inner .bet-single-area {
  background:#5F46D5;
  border-radius: 10px;
  margin-bottom: 5px;
}

.match .inner .bet-single-area .head-area {
  background: #382591;
