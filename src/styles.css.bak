}

.bet-single-area .head-area p {
  margin-left: 20px;
}

.bet-single-area .bet-main-content {
  display: flex;
  margin: 50px 20px 40px;
}

.bet-single-area .bet-main-content .team-single {
  text-align: center;
}

.bet-single-area .bet-main-content .team-single .mdr {
  color: #fff
}

.bet-single-area .bet-main-content .team-single .img-area {
  margin-top: 25px;
}

.bet-single-area .bet-main-content .mid-area .countdown {
  border:1px solid #fff;
  border-radius: 20px;
  padding: 10px 10px;
  margin-bottom: 26px;
  opacity:0.8;
  color:#000
}

.bet-single-area .bet-main-content .mid-area .countdown h4 {
  margin: 0;
  color:#000;
  font-size: 14px;
}

.bet-single-area .bet-main-content .team-single .img-area img {
  width:100px;
  height:100px;
}

.bet-single-area .bet-main-content .value {
