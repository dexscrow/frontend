  color:#fff;
}


.bet-single-area .bet-main-content .info {
  color:#fff;
  opacity:0.7
}

.single-area .bet-main-content .mid-area .countdown h4 span {
  font-size: 14px;
  color:#000;
  font-weight: inherit;
}

.bet-single-area .bottom-item {
  border-top: 1px solid #8e78c0;
  padding: 30px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.betpop{
  border:1px solid #5F46D5;
  min-height:200px;
  border-radius:10px;
}

.betpop .top-item {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px solid #8e78c0;
  margin-bottom: 30px;
  padding-bottom: 30px;
}

.betpop .top-item .cmn-btn.active {
  background: #cab4ff;
  color: #291b6b;
}

.betpop .select-odds {
  border-radius: 10px;
  background-color: #382590;
  padding: 30px;
}

.betpop .select-odds .in-dec-val {
  width: 20%;
  margin-left: 20px;
  border-style: solid;
  border-width: 1px;
  border-color: #5b41d1;
  border-radius: 10px;
  background-color: #fff;
}

.betpop .in-dec-val {
  border: 1px solid #5b41d1;
  border-radius: 10px;
  background-color: #382590;
  width: 250px;
  height:40px;
  position: relative;
}

.betpop .in-dec-val input {
  display: inline;
  border: none;
  text-align: center;
  border-radius: 10px;
  height:40px;
  color:#fff;
  background-color: #382590;
  padding-left: 0;
}

.betpop .btn-area {
  display: grid;
  position: absolute;
  right: 15px;
}

.betpop .in-dec-val .btn-area button {
  background: transparent;
  padding: 0;
  width: 12px;
  height: 15px;
}

.betpop .in-dec-val .btn-area button img {
  max-width: unset;
}

.betpop .mid-area {
  justify-content: space-between;
  align-items: center;
  margin-top: 30px;
}

.betpop .mid-area .single-area{
  width:100%;	
}

.betpop .mid-area .single-area .item-title {
  margin-bottom: 5px;
}

.betpop .mid-area .single-area .nice-select {
  background: transparent;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  width: 33%;
  height: 0;
}

.betpop .mid-area .single-area .nice-select::after {
  height: 10px;
  margin-top: -8px;
  pointer-events: none;
  position: absolute;
  right: 20px;
  width: 10px;
}

.betpop .mid-area .single-area .nice-select .list {
  width: 100%;
  background: var(--body-color);
  border: 1px solid #483f90;
}

.betpop .mid-area .single-area .nice-select .list .option {
  background: transparent;
}

.bet .mid-area .single-area .nice-select .list .option:hover {
  color: var(--head-color);
}

.betpop .mid-area .single-area .nice-select .list .focus {
  background-color: transparent;
  color: var(--head-color);
}

.betpop .mid-area .single-area .input-item .quickIn {
  border-style: solid;
  border-width: 1px;
  border-color: #5b41d1;
  border-radius: 10px;
  background-color: #382590;
  color: var(--bs-white);
  padding: 10px;
}

.betpop .mid-area .single-area .input-item .quickIn:hover {
  border: 1px solid #25ad5f;
  transition: 0.3s;
}

.betpop .mid-area .single-area.smart-value {
  border-radius: 10px;
  background-color: #382590;
  padding: 12px 10px;
}

.betpop .mid-area .single-area.smart-value h5 {
  margin-left: 15px;
}

.betpop .bottom-area {
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #8e78c0;
  margin-top: 30px;
  padding-top: 30px;
}

.betpop .bottom-area p span {
  color: #ffe1e5;
}

.betpop .bottom-area .fee-area p .amount {
  color: #8bffbd;
}

.betpop .bottom-area .btn-area button {
  padding: 0 25px;
  display: flex;
  align-items: center;
  height: 100%;
  color: var(--bs-white);
